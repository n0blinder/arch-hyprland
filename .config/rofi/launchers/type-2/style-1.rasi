/**
 *
 * Omarchy-inspired Type 2
 * Based on adi1090x
 *
 **/

configuration {
    modi: "drun";
    show-icons: true;
    display-drun: "";
    drun-display-format: "{name}";
}

@import "shared/colors.rasi"
@import "shared/fonts.rasi"

window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;

    width: 600px;

    margin: 0px;
    padding: 0px;

    border: 3px solid;
    border-radius: 0px;
    border-color: @selected;

    background-color: @background;
}

mainbox {
    spacing: 12px;
    padding: 18px;
    background-color: transparent;

    children: [ "inputbar", "listview" ];
}

inputbar {
    spacing: 10px;
    padding: 12px;

    border: 0px;
    border-radius: 0px;

    background-color: @background-alt;
    text-color: @foreground;

    children: [ "prompt", "entry" ];
}

prompt {
    background-color: inherit;
    text-color: @selected;
}

textbox-prompt-colon {
    enabled: false;
}

entry {
    background-color: inherit;
    text-color: inherit;

    placeholder: "Search...";
    placeholder-color: #7f849c;
}

listview {
    columns: 1;
    lines: 10;

    cycle: true;
    dynamic: true;
    scrollbar: false;

    spacing: 8px;

    margin: 0px;
    padding: 0px;

    background-color: transparent;
}

element {
    spacing: 12px;
    padding: 10px;

    border: 0px;
    border-radius: 0px;

    background-color: transparent;
    text-color: @foreground;
}

element normal.normal {
    background-color: @background;
    text-color: @foreground;
}

element selected.normal {
    background-color: @selected;
    text-color: @background;
}

element-icon {
    background-color: transparent;
    text-color: inherit;

    size: 24px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

scrollbar {
    enabled: false;
}

error-message {
    padding: 12px;

    border: 2px solid;
    border-radius: 0px;
    border-color: @selected;

    background-color: @background;
}

textbox {
    background-color: transparent;
    text-color: @foreground;
}
