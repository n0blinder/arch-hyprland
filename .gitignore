# Shell histories captured from the real machine (may contain private paths)
.bash_history
.zsh_history

# Reverse-shell / port-4444 note — deliberately excluded from the setup
rev-shell-firewall.txt

# Backups of configs adjusted for this repo
*.orig

# Superseded backup files
*.bak

# Test / scratch artifacts (not part of the installer)
hypr2/
greetd/readme.txt
greetd/vtrgb

# Stray files inside the hypr config that must not ship
# (install.sh also strips these from the deployed copy)
.config/hypr/.bashrc
.config/hypr/.zshrc

# Debug screenshots/photos dropped at the repo root
# (does not affect wallpaper/ or .config/rofi/images/)
/*.png
/*.jpg
/*.jpeg

# Personal scratch TODO (not part of the installer)
next-steps.txt
